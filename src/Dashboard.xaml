<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ADAMO GT — проверка компьютера" Width="1200" Height="760"
        MinWidth="960" MinHeight="720" WindowStartupLocation="CenterScreen"
        Background="#F3F4F5" Foreground="#1D1D1F" FontFamily="Segoe UI" FontSize="14"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <SolidColorBrush x:Key="Muted" Color="#4B5158" />
        <SolidColorBrush x:Key="Teal" Color="#52785B" />
        <SolidColorBrush x:Key="Amber" Color="#916111" />
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#1D1D1F" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="Heading" TargetType="TextBlock" BasedOn="{StaticResource Label}">
            <Setter Property="Foreground" Value="#2C3136" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#D7DBDE" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="14,6" />
        </Style>
        <Style x:Key="Metric" TargetType="TextBlock">
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#2C3136" />
            <Setter Property="Background" Value="#FAFBFC" />
            <Setter Property="BorderBrush" Value="#CAD0D5" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="11,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#EDF0F2" /></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#E4E8EC" /><Setter Property="Foreground" Value="#1D1D1F" /></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#34781F" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Background" Value="#ECEFF2" /><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#D7DBDE" /><Setter Property="Foreground" Value="#5B6269" /><Setter Property="Cursor" Value="Arrow" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <Style TargetType="ToolTip">
            <Setter Property="Foreground" Value="#1D1D1F" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#CAD0D5" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="MaxWidth" Value="480" />
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style TargetType="ProgressBar">
            <Setter Property="Minimum" Value="0" /><Setter Property="Maximum" Value="100" />
            <Setter Property="Height" Value="5" /><Setter Property="Foreground" Value="#69747E" />
            <Setter Property="Background" Value="#E8EBEE" />
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="ProgressBar"><Grid>
                    <Border Background="{TemplateBinding Background}" CornerRadius="3" />
                    <Border x:Name="PART_Track" />
                    <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" HorizontalAlignment="Left" CornerRadius="3" />
                </Grid></ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#1D1D1F" /><Setter Property="Padding" Value="8,6" />
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="ItemBorder" Background="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter /></Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#EDF0F2" /></Trigger>
                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#E4E8EC" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#1D1D1F" /><Setter Property="FontSize" Value="14" />
            <Setter Property="Height" Value="26" /><Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="ComboBox"><Grid>
                    <ToggleButton Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                        <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="SelectBorder" Background="#FAFBFC" BorderBrush="#D7DBDE" BorderThickness="1" CornerRadius="5">
                                <Path Data="M 0 0 L 4 4 L 8 0" Stroke="#4B5158" StrokeThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,9,0" />
                            </Border>
                            <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SelectBorder" Property="BorderBrush" Value="#69747E" /></Trigger></ControlTemplate.Triggers>
                        </ControlTemplate></ToggleButton.Template>
                    </ToggleButton>
                    <ContentPresenter Margin="7,0,25,0" VerticalAlignment="Center" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}">
                        <ContentPresenter.Resources><Style TargetType="TextBlock"><Setter Property="TextTrimming" Value="CharacterEllipsis" /><Setter Property="Foreground" Value="#1D1D1F" /><Setter Property="FontSize" Value="14" /></Style></ContentPresenter.Resources>
                    </ContentPresenter>
                    <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                        <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxWidth="680" Background="#FFFFFF" BorderBrush="#CAD0D5" BorderThickness="1" CornerRadius="5" Margin="0,3,0,0" Padding="3">
                            <ScrollViewer MaxHeight="240" CanContentScroll="True"><ItemsPresenter /></ScrollViewer>
                        </Border>
                    </Popup>
                </Grid></ControlTemplate>
            </Setter.Value></Setter>
        </Style>
    </Window.Resources>
    <Grid x:Name="DashboardRoot" Margin="16,10,16,10">
        <Grid.RowDefinitions><RowDefinition Height="56" /><RowDefinition Height="*" /><RowDefinition Height="58" /></Grid.RowDefinitions>
        <Grid Margin="0,0,0,2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Image x:Name="AppLogo" Width="34" Height="34" Margin="0,0,12,0" HorizontalAlignment="Left" VerticalAlignment="Center" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                <TextBlock x:Name="ComputerModel" Text="Определение модели компьютера…" FontSize="21" FontWeight="SemiBold" />
                <TextBlock x:Name="WindowsName" Text="Собираем характеристики…" Style="{StaticResource Label}" Margin="0,2,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="CrmButton" Content="CRM" Margin="0,0,7,0" Visibility="Collapsed" IsEnabled="False" ToolTip="Создать товар в CRM, приложить фото характеристик и напечатать стикеры AD. Только из офиса." />
                <Button x:Name="StressTestButton" Content="Стресс" Margin="0,0,7,0" IsEnabled="False" ToolTip="Выбрать стресс-нагрузку CPU, RAM, SSD и GPU" />
                <Button x:Name="SaveReportButton" Content="Отчёт" Margin="0,0,7,0" ToolTip="Сохранить характеристики, источники и результаты тестов в JSON" />
                <Button x:Name="RefreshButton" Content="Обновить" ToolTip="Обновить характеристики и показания датчиков" />
            </StackPanel>
        </Grid>
        <Grid x:Name="CardsGrid" Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="3*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="2*" /></Grid.ColumnDefinitions>
            <Grid x:Name="HardwareColumn">
                <Grid.RowDefinitions>
                    <RowDefinition Height="0.96*" /><RowDefinition Height="7" />
                    <RowDefinition Height="0.99*" /><RowDefinition Height="7" />
                    <RowDefinition Height="1.33*" /><RowDefinition Height="7" />
                    <RowDefinition Height="0.97*" /><RowDefinition Height="7" /><RowDefinition Height="1.04*" />
                </Grid.RowDefinitions>
                <Border x:Name="CpuCard" Style="{StaticResource Card}" Padding="14,0">
                    <Grid VerticalAlignment="Center">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="CPU" Style="{StaticResource Heading}" /><TextBlock Grid.Column="1" x:Name="CpuTopology" Text="Ядра и потоки: определение…" Style="{StaticResource Label}" /></Grid>
                        <TextBlock Grid.Row="1" x:Name="CpuName" Text="Определение процессора…" FontSize="21" FontWeight="SemiBold" />
                        <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal"><TextBlock x:Name="CpuClockLabel" Text="Частота: " /><TextBlock x:Name="CpuClock" Text="Нет данных" /></StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="6,0,0,0"><TextBlock x:Name="CpuTemperatureLabel" Text="Температура ⓘ: " Cursor="Help" /><TextBlock x:Name="CpuTemperature" Text="Нет данных" /></StackPanel>
                        </Grid>
                        <TextBlock Grid.Row="3" x:Name="CpuCache" Text="Кэш: L1 — · L2 — · L3 —" Style="{StaticResource Label}" Margin="0,1,0,0" />
                    </Grid>
                </Border>
                <Border x:Name="RamCard" Grid.Row="2" Style="{StaticResource Card}" Padding="14,0">
                    <Grid VerticalAlignment="Center">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="RAM" Style="{StaticResource Heading}" /><TextBlock Grid.Column="1" x:Name="RamMaximum" Text="Максимум: нет данных" Style="{StaticResource Label}" Margin="6,0,0,0" /></Grid>
                        <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock x:Name="RamInstalled" Text="Нет данных" FontSize="23" FontWeight="SemiBold" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,1" VerticalAlignment="Bottom"><TextBlock x:Name="RamType" Text="Тип памяти: —" /><TextBlock Text=" · " /><TextBlock x:Name="RamRate" Text="Нет данных" /></StackPanel>
                        </Grid>
                        <TextBlock Grid.Row="2" x:Name="RamSlots" Text="Планки и слоты: определение…" />
                        <Grid Grid.Row="3" Margin="0,2,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock x:Name="RamConfiguration" Text="Конфигурация: нет данных" Style="{StaticResource Label}" />
                            <TextBlock Grid.Column="1" x:Name="RamClock" Text="Такт DDR: нет данных" Style="{StaticResource Label}" Margin="8,0,0,0" />
                        </Grid>
                    </Grid>
                </Border>
                <Border x:Name="GpuCard" Grid.Row="4" Style="{StaticResource Card}" Padding="14,2">
                    <Grid VerticalAlignment="Center">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="GPU" Style="{StaticResource Heading}" /><TextBlock x:Name="GpuType" Grid.Column="1" Text="Тип: определение…" Style="{StaticResource Label}" /></Grid>
                        <ComboBox x:Name="GpuSelector" Grid.Row="1" Margin="0,2,0,3" ToolTip="Выберите видеокарту" />
                        <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><TextBlock x:Name="GpuMemoryKind" Text="Видеопамять: " /><TextBlock x:Name="GpuMemory" Text="Нет данных" /></StackPanel><TextBlock x:Name="GpuSharedMemory" Grid.Column="1" Text="Общая RAM: нет данных" HorizontalAlignment="Right" Margin="8,0,0,0" /></Grid>
                        <Grid Grid.Row="3" Margin="0,2,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal"><TextBlock Text="Температура: " Style="{StaticResource Label}" /><TextBlock x:Name="GpuTemperature" Text="Нет данных" Style="{StaticResource Label}" /></StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,2,0"><TextBlock Text="Загрузка: " Style="{StaticResource Label}" /><TextBlock x:Name="GpuLoad" Text="Нет данных" Style="{StaticResource Label}" /></StackPanel>
                        </Grid>
                        <Border Grid.Row="4" Background="#FAFBFC" CornerRadius="5" Padding="7,4">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock x:Name="GpuBenchmarkResult" Text="GPU-тест · ожидает запуска" VerticalAlignment="Center" />
                                <Button x:Name="RunGpuTestButton" Grid.Column="1" Content="Тест GPU" Padding="7,2" Margin="6,0,0,0" IsEnabled="False" />
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
                <Border x:Name="ScreenCard" Grid.Row="6" Style="{StaticResource Card}" Padding="14,0">
                    <Grid VerticalAlignment="Center">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Экран" Style="{StaticResource Heading}" VerticalAlignment="Center" />
                            <ComboBox x:Name="ScreenSelector" Grid.Column="1" HorizontalAlignment="Right" Width="180" Height="22" Margin="10,0,0,0" />
                        </Grid>
                        <TextBlock Grid.Row="1" x:Name="ScreenResolution" Text="Разрешение: нет данных" FontSize="20" FontWeight="SemiBold" Margin="0,1,0,1" />
                        <TextBlock Grid.Row="2" x:Name="ScreenMatrix" Text="Тип матрицы: не подтверждён" Style="{StaticResource Label}" />
                        <TextBlock Grid.Row="3" x:Name="ScreenBrightness" Text="Яркость в нитах: не подтверждена" Style="{StaticResource Label}" />
                    </Grid>
                </Border>
                <Border x:Name="PortsCard" Grid.Row="8" Style="{StaticResource Card}" Padding="14,1">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Порты · по спецификации" Style="{StaticResource Heading}" VerticalAlignment="Center" />
                            <Button x:Name="PortsSourceButton" Grid.Column="1" Content="Источник" Padding="5,2" IsEnabled="False" />
                            <Button x:Name="PortsRefreshButton" Grid.Column="2" Content="↻" Padding="6,2" Margin="4,0,0,0" IsEnabled="False" ToolTip="Найти порты в интернете: после согласия передаётся производитель и модель компьютера" />
                            <Button x:Name="PortsSearchButton" Grid.Column="3" Content="Поиск" Padding="5,2" Margin="4,0,0,0" IsEnabled="False" ToolTip="Открыть поиск модели в DuckDuckGo: перед запуском появится пояснение" />
                        </Grid>
                        <Grid Grid.Row="1" Margin="0,2,0,1">
                            <TextBlock x:Name="PortsEmpty" Text="Локальный справочник или поиск по запросу" Style="{StaticResource Label}" TextWrapping="Wrap" VerticalAlignment="Center" />
                            <ScrollViewer x:Name="PortsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                                <StackPanel>
                                    <UniformGrid x:Name="PortsList" Columns="5" />
                                    <Grid Margin="0,2,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <TextBlock x:Name="OptionalPortsLabel" Text="Опционально: " FontSize="13" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Visibility="Collapsed" />
                                        <UniformGrid x:Name="OptionalPortsList" Grid.Column="1" Columns="2" />
                                    </Grid>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                        <TextBlock x:Name="PortsStatus" Grid.Row="2" Text="Ожидание проверки производителя" Style="{StaticResource Label}" />
                    </Grid>
                </Border>
            </Grid>
            <Grid x:Name="ConditionColumn" Grid.Column="2">
                <Grid.RowDefinitions><RowDefinition Height="1.35*" /><RowDefinition Height="10" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Border x:Name="DiskCard" Style="{StaticResource Card}" Padding="16,6">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="НАКОПИТЕЛЬ" Style="{StaticResource Heading}" /><TextBlock x:Name="DiskType" Grid.Column="1" Text="Тип: —" Style="{StaticResource Label}" Margin="8,0,0,0" /></Grid>
                        <Grid Grid.Row="1" Margin="0,4,0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <ComboBox x:Name="DiskSelector" ToolTip="Выберите физический накопитель" />
                            <TextBlock x:Name="DiskSize" Grid.Column="1" Text="—" FontSize="23" FontWeight="SemiBold" Margin="9,0,0,0" />
                        </Grid>
                        <Grid Grid.Row="2" VerticalAlignment="Center" Margin="0,2,0,3">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*" /><ColumnDefinition Width="1" /><ColumnDefinition Width="1.05*" /><ColumnDefinition Width="1" /><ColumnDefinition Width="0.85*" /></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,9,0"><TextBlock x:Name="DiskHealth" Text="Нет данных" Style="{StaticResource Metric}" /><TextBlock Text="Остаток ресурса" Style="{StaticResource Label}" /><ProgressBar x:Name="DiskHealthBar" Foreground="{StaticResource Teal}" Margin="0,5,0,0" /></StackPanel>
                            <Border Grid.Column="1" Background="#D7DBDE" Margin="0,4" />
                            <StackPanel Grid.Column="2" Margin="10,0,8,0"><TextBlock x:Name="PowerOnHours" Text="Нет данных" FontSize="25" FontWeight="SemiBold" /><TextBlock Text="Часов работы" Style="{StaticResource Label}" Margin="0,2,0,0" /></StackPanel>
                            <Border Grid.Column="3" Background="#D7DBDE" Margin="0,4" />
                            <StackPanel Grid.Column="4" Margin="10,0,0,0"><TextBlock x:Name="DiskTemperature" Text="Нет данных" FontSize="25" FontWeight="SemiBold" /><TextBlock Text="Температура" Style="{StaticResource Label}" Margin="0,2,0,0" /></StackPanel>
                        </Grid>
                        <TextBlock x:Name="SmartWarning" Grid.Row="3" Text="SMART: ожидает чтения" FontSize="13" Margin="0,0,0,4" />
                        <Grid Grid.Row="4">
                            <Grid.RowDefinitions><RowDefinition Height="1" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Border Background="#D7DBDE" />
                            <TextBlock Grid.Row="1" Text="ТЕСТ СКОРОСТИ" Foreground="#2C3136" FontSize="13" FontWeight="SemiBold" Margin="0,5,0,0" />
                            <Grid x:Name="DiskSpeedMeasurements" Grid.Row="2" VerticalAlignment="Center" Margin="0,3,0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="1" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,8,0"><TextBlock x:Name="DiskRead" Text="—" FontSize="22" FontWeight="SemiBold" Foreground="#2C3136" /><TextBlock x:Name="DiskReadLabel" Text="Чтение" Style="{StaticResource Label}" Margin="0,2,0,0" /></StackPanel>
                                <Border Grid.Column="1" Background="#D7DBDE" />
                                <StackPanel Grid.Column="2" Margin="12,0,0,0"><TextBlock x:Name="DiskWrite" Text="—" FontSize="22" FontWeight="SemiBold" Foreground="#2C3136" /><TextBlock x:Name="DiskWriteLabel" Text="Запись" Style="{StaticResource Label}" Margin="0,2,0,0" /></StackPanel>
                            </Grid>
                            <TextBlock Grid.Row="3" x:Name="DiskTestProfile" Text="Последовательный · QD1" Style="{StaticResource Label}" />
                        </Grid>
                        <StackPanel Grid.Row="5" Margin="0,4,0,0">
                            <TextBlock x:Name="BenchmarkStage" Text="Тест начнётся после показа характеристик" Style="{StaticResource Label}" />
                            <ProgressBar x:Name="BenchmarkBar" Height="3" Margin="0,5,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border x:Name="BatteryCard" Grid.Row="2" Style="{StaticResource Card}" Padding="16,12">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <TextBlock Text="БАТАРЕЯ" Style="{StaticResource Heading}" />
                        <Grid Grid.Row="1" VerticalAlignment="Center" Margin="0,3,0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock x:Name="BatteryHealth" Text="Нет данных" FontSize="36" FontWeight="SemiBold" Foreground="{StaticResource Amber}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0"><TextBlock Text="Сохранённая ёмкость" /><ProgressBar x:Name="BatteryHealthBar" Foreground="{StaticResource Amber}" Height="8" Margin="0,7,0,0" /></StackPanel>
                        </Grid>
                        <Grid Grid.Row="2" Margin="0,0,0,9"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal"><TextBlock x:Name="BatteryChargeLabel" Text="Заряд " /><TextBlock x:Name="BatteryPercent" Text="Нет данных" FontWeight="SemiBold" /></StackPanel>
                            <TextBlock x:Name="BatteryStatus" Grid.Column="1" Text="Определение батареи…" Style="{StaticResource Label}" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </Grid>
                        <Grid Grid.Row="3">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="1" /><RowDefinition Height="24" /><RowDefinition Height="1" /><RowDefinition Height="24" /><RowDefinition Height="1" /><RowDefinition Height="24" /><RowDefinition Height="1" /><RowDefinition Height="24" /></Grid.RowDefinitions>
                            <Border Grid.ColumnSpan="2" Background="#D7DBDE" /><Border Grid.Row="2" Grid.ColumnSpan="2" Background="#D7DBDE" /><Border Grid.Row="4" Grid.ColumnSpan="2" Background="#D7DBDE" />
                            <TextBlock Grid.Row="1" Text="При полном заряде" VerticalAlignment="Center" /><TextBlock x:Name="BatteryFullCapacity" Grid.Row="1" Grid.Column="1" Text="—" FontSize="15" VerticalAlignment="Center" Margin="8,0,0,0" />
                            <TextBlock Grid.Row="3" Text="Заводская ёмкость" VerticalAlignment="Center" /><TextBlock x:Name="BatteryDesignCapacity" Grid.Row="3" Grid.Column="1" Text="—" FontSize="15" VerticalAlignment="Center" Margin="8,0,0,0" />
                            <TextBlock Grid.Row="5" Text="Циклы зарядки" VerticalAlignment="Center" /><TextBlock x:Name="BatteryCycles" Grid.Row="5" Grid.Column="1" Text="—" FontSize="15" VerticalAlignment="Center" Margin="8,0,0,0" />
                            <Border Grid.Row="6" Grid.ColumnSpan="2" Background="#D7DBDE" />
                            <TextBlock x:Name="BatteryRuntimeLabel" Grid.Row="7" Text="Лёгкая работа · оценка" FontSize="13" VerticalAlignment="Center" /><TextBlock x:Name="BatteryRuntime" Grid.Row="7" Grid.Column="1" Text="—" FontSize="14" VerticalAlignment="Center" Margin="8,0,0,0" />
                        </Grid>
                        <TextBlock x:Name="BatteryDetail" Grid.Row="4" Text="" Style="{StaticResource Label}" Margin="0,3,0,0" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
        <Grid Grid.Row="2" Margin="0,6,0,0">
            <Grid.RowDefinitions><RowDefinition Height="30" /><RowDefinition Height="2" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock x:Name="StartupStatus" Text="Определяем характеристики компьютера…" VerticalAlignment="Center" Margin="0,0,9,0" />
                <Button x:Name="PeripheralTestsButton" Grid.Column="1" Content="Устройства" Padding="9,5" Margin="0,0,7,0" VerticalAlignment="Center" ToolTip="Камера, микрофон, клавиатура и динамики — ручная проверка" />
                <Button x:Name="SensorsButton" Grid.Column="2" Content="Датчики" Padding="9,5" Background="Transparent" VerticalAlignment="Center" />
                <Button x:Name="StopTestButton" Grid.Column="3" Content="Остановить" Padding="11,5" Margin="7,0,0,0" VerticalAlignment="Center" IsEnabled="False" />
                <Button x:Name="RunTestButton" Grid.Column="4" Content="Повторить SSD" Padding="11,5" Margin="7,0,0,0" VerticalAlignment="Center" IsEnabled="False" />
            </Grid>
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Text="Собираем данные оборудования…" Style="{StaticResource Label}" Margin="0,0,12,0" VerticalAlignment="Center" />
                <TextBlock x:Name="BrandFooter" Grid.Column="1" FontSize="12" FontWeight="Medium" Foreground="#5B6269" VerticalAlignment="Center"><Run Text="Creat cu " /><Run Text="❤️" FontFamily="Segoe UI Emoji" Foreground="#B94A48" /><Run Text=" în Moldova | ADAMO.MD" /></TextBlock>
            </Grid>
        </Grid>
    </Grid>
</Window>
